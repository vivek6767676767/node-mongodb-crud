<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Teacher Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            background-color: #f5f5f5;
        }

        .container {
            background: white;
            padding: 25px;
            border-radius: 10px;
            max-width: 1100px;
            margin: auto;
        }

        h1 {
            color: #222;
        }

        form {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        input {
            padding: 10px;
            border: 1px solid #aaa;
            border-radius: 5px;
        }

        button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            color: white;
        }

        button:hover {
            opacity: 0.8;
        }

        .add-btn {
            background-color: green;
        }

        .update-btn {
            background-color: orange;
        }

        .delete-btn {
            background-color: red;
        }

        .get-btn {
            background-color: blue;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        th,
        td {
            border: 1px solid #aaa;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #333;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .actions button {
            margin-right: 5px;
        }

        #message {
            margin: 15px 0;
            font-weight: bold;
        }

        @media (max-width: 900px) {
            form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Teacher Management</h1>

    <!-- Teacher Form -->
    <form id="teacherForm">

        <input
            type="text"
            id="name"
            placeholder="Enter Name"
            required
        >

        <input
            type="email"
            id="email"
            placeholder="Enter Email"
            required
        >

        <input
            type="text"
            id="subject"
            placeholder="Enter Subject"
            required
        >

        <input
            type="number"
            id="experience"
            placeholder="Experience (Years)"
            required
        >

        <input
            type="text"
            id="city"
            placeholder="Enter City"
            required
        >

        <button type="submit" class="add-btn">
            Add Teacher
        </button>

        <button type="button" class="update-btn" onclick="updateTeacher()">
            Update Teacher
        </button>

        <button type="button" class="delete-btn" onclick="deleteTeacher()">
            Delete Teacher
        </button>

    </form>


    <div id="message"></div>


    <!-- Get Teachers -->
    <button class="get-btn" onclick="getTeachers()">
        Get Teachers
    </button>


    <!-- Teacher Table -->
    <table>

        <thead>

            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Subject</th>
                <th>Experience</th>
                <th>City</th>
                <th>Action</th>
            </tr>

        </thead>

        <tbody id="teacherTable"></tbody>

    </table>

</div>


<script>

    // ==============================
    // GET TEACHERS
    // ==============================

    async function getTeachers() {

        try {

            const response = await fetch('/teacher/getdata');

            const result = await response.json();

            console.log(result);

            const table = document.getElementById('teacherTable');

            table.innerHTML = '';

            result.data.forEach(teacher => {

                const row = document.createElement('tr');

                row.innerHTML = `

                    <td>${teacher.name || ''}</td>

                    <td>${teacher.email || ''}</td>

                    <td>${teacher.subject || ''}</td>

                    <td>${teacher.experience || ''}</td>

                    <td>${teacher.city || ''}</td>

                    <td class="actions">

                        <button
                            class="update-btn"
                            onclick="fillForm(
                                '${teacher.name}',
                                '${teacher.email || ''}',
                                '${teacher.subject || ''}',
                                '${teacher.experience || ''}',
                                '${teacher.city || ''}'
                            )">
                            Edit
                        </button>

                        <button
                            class="delete-btn"
                            onclick="deleteTeacherByName('${teacher.name}')">
                            Delete
                        </button>

                    </td>

                `;

                table.appendChild(row);

            });

            showMessage("Teachers loaded successfully", "green");

        } catch (error) {

            console.log(error);

            showMessage("Error loading teachers", "red");

        }

    }


    // ==============================
    // POST / INSERT TEACHER
    // ==============================

    document.getElementById('teacherForm').addEventListener(
        'submit',
        async function(event) {

            event.preventDefault();

            const teacherData = {

                name: document.getElementById('name').value,

                email: document.getElementById('email').value,

                subject: document.getElementById('subject').value,

                experience: Number(
                    document.getElementById('experience').value
                ),

                city: document.getElementById('city').value

            };


            try {

                const response = await fetch(
                    '/teacher/insertdata',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify(teacherData)
                    }
                );

                const result = await response.json();

                console.log(result);

                if (result.status === 200) {

                    showMessage(
                        "Teacher added successfully",
                        "green"
                    );

                    document
                        .getElementById('teacherForm')
                        .reset();

                    getTeachers();

                } else {

                    showMessage(result.message, "red");

                }

            } catch (error) {

                console.log(error);

                showMessage(
                    "Error adding teacher",
                    "red"
                );

            }

        }
    );


    // ==============================
    // PUT / UPDATE TEACHER
    // ==============================

    async function updateTeacher() {

        const name =
            document.getElementById('name').value;

        const email =
            document.getElementById('email').value;

        const subject =
            document.getElementById('subject').value;

        const experience =
            document.getElementById('experience').value;

        const city =
            document.getElementById('city').value;


        if (!name) {

            showMessage(
                "Enter teacher name first",
                "red"
            );

            return;

        }


        const teacherData = {

            email: email,

            subject: subject,

            experience: Number(experience),

            city: city

        };


        try {

            const response = await fetch(
                `/teacher/updatedata?name=${encodeURIComponent(name)}`,
                {
                    method: 'PUT',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(teacherData)
                }
            );


            const result = await response.json();

            console.log(result);


            if (result.status === 200) {

                showMessage(
                    "Teacher updated successfully",
                    "green"
                );

                getTeachers();

            } else {

                showMessage(
                    result.message,
                    "red"
                );

            }

        } catch (error) {

            console.log(error);

            showMessage(
                "Error updating teacher",
                "red"
            );

        }

    }


    // ==============================
    // DELETE TEACHER
    // ==============================

    async function deleteTeacher() {

        const name =
            document.getElementById('name').value;


        if (!name) {

            showMessage(
                "Enter teacher name first",
                "red"
            );

            return;

        }


        deleteTeacherByName(name);

    }


    async function deleteTeacherByName(name) {

        const confirmDelete = confirm(
            `Are you sure you want to delete ${name}?`
        );


        if (!confirmDelete) {

            return;

        }


        try {

            const response = await fetch(
                `/teacher/deletedata?name=${encodeURIComponent(name)}`,
                {
                    method: 'DELETE'
                }
            );


            const result = await response.json();

            console.log(result);


            if (result.status === 200) {

                showMessage(
                    "Teacher deleted successfully",
                    "green"
                );

                document
                    .getElementById('teacherForm')
                    .reset();

                getTeachers();

            } else {

                showMessage(
                    result.message,
                    "red"
                );

            }

        } catch (error) {

            console.log(error);

            showMessage(
                "Error deleting teacher",
                "red"
            );

        }

    }


    // ==============================
    // FILL FORM
    // ==============================

    function fillForm(
        name,
        email,
        subject,
        experience,
        city
    ) {

        document.getElementById('name').value =
            name;

        document.getElementById('email').value =
            email;

        document.getElementById('subject').value =
            subject;

        document.getElementById('experience').value =
            experience;

        document.getElementById('city').value =
            city;

        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });

    }


    // ==============================
    // MESSAGE
    // ==============================

    function showMessage(message, color) {

        const messageBox =
            document.getElementById('message');

        messageBox.innerText = message;

        messageBox.style.color = color;


        setTimeout(() => {

            messageBox.innerText = '';

        }, 3000);

    }


    // ==============================
    // LOAD DATA
    // ==============================

    getTeachers();

</script>

</body>

</html>