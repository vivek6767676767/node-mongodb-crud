<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            background-color: #f5f5f5;
        }

        h1 {
            color: #222;
        }

        .container {
            background: white;
            padding: 25px;
            border-radius: 10px;
            max-width: 1100px;
            margin: auto;
        }

        form {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        input {
            padding: 10px;
            border: 1px solid #aaa;
            border-radius: 5px;
        }

        button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background-color: #333;
            color: white;
        }

        button:hover {
            opacity: 0.8;
        }

        .add-btn {
            background-color: green;
        }

        .update-btn {
            background-color: orange;
        }

        .delete-btn {
            background-color: red;
        }

        .get-btn {
            background-color: blue;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th, td {
            border: 1px solid #aaa;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #333;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .actions button {
            margin-right: 5px;
        }

        #message {
            margin: 15px 0;
            font-weight: bold;
        }

        @media (max-width: 800px) {
            form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>Student Management</h1>

    <!-- Student Form -->
    <form id="studentForm">

        <input
            type="text"
            id="name"
            placeholder="Enter Name"
            required
        >

        <input
            type="email"
            id="email"
            placeholder="Enter Email"
            required
        >

        <input
            type="number"
            id="age"
            placeholder="Enter Age"
            required
        >

        <input
            type="text"
            id="city"
            placeholder="Enter City"
            required
        >

        <button type="submit" class="add-btn">
            Add Student
        </button>

        <button type="button" class="update-btn" onclick="updateStudent()">
            Update Student
        </button>

        <button type="button" class="delete-btn" onclick="deleteStudent()">
            Delete Student
        </button>

    </form>


    <!-- Message -->
    <div id="message"></div>


    <!-- Get Students -->
    <button class="get-btn" onclick="getStudents()">
        Get Students
    </button>


    <!-- Student Table -->
    <table>

        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Age</th>
                <th>City</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody id="studentTable">
        </tbody>

    </table>

</div>


<script>

    // ==============================
    // GET STUDENTS
    // ==============================

    async function getStudents() {

        try {

            const response = await fetch('/student/getdata');

            const result = await response.json();

            console.log(result);

            const table = document.getElementById('studentTable');

            table.innerHTML = '';

            result.data.forEach(student => {

                const row = document.createElement('tr');

                row.innerHTML = `
                    <td>${student.name || ''}</td>
                    <td>${student.email || ''}</td>
                    <td>${student.age || ''}</td>
                    <td>${student.city || ''}</td>

                    <td class="actions">

                        <button
                            class="update-btn"
                            onclick="fillForm('${student.name}', '${student.email || ''}', '${student.age || ''}', '${student.city || ''}')">
                            Edit
                        </button>

                        <button
                            class="delete-btn"
                            onclick="deleteStudentByName('${student.name}')">
                            Delete
                        </button>

                    </td>
                `;

                table.appendChild(row);

            });

            showMessage("Students loaded successfully", "green");

        } catch (error) {

            console.log(error);

            showMessage("Error loading students", "red");

        }

    }


    // ==============================
    // POST / INSERT STUDENT
    // ==============================

    document.getElementById('studentForm').addEventListener('submit', async function(event) {

        event.preventDefault();

        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const age = document.getElementById('age').value;
        const city = document.getElementById('city').value;

        const studentData = {

            name: name,
            email: email,
            age: Number(age),
            city: city

        };

        try {

            const response = await fetch('/student/insertdata', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(studentData)

            });

            const result = await response.json();

            console.log(result);

            if (result.status === 200) {

                showMessage("Student added successfully", "green");

                document.getElementById('studentForm').reset();

                getStudents();

            } else {

                showMessage(result.message, "red");

            }

        } catch (error) {

            console.log(error);

            showMessage("Error adding student", "red");

        }

    });


    // ==============================
    // PUT / UPDATE STUDENT
    // ==============================

    async function updateStudent() {

        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const age = document.getElementById('age').value;
        const city = document.getElementById('city').value;

        if (!name) {

            showMessage("Enter student name first", "red");

            return;

        }

        const studentData = {

            email: email,
            age: Number(age),
            city: city

        };

        try {

            const response = await fetch(
                `/student/updatedata?name=${encodeURIComponent(name)}`,
                {

                    method: 'PUT',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify(studentData)

                }
            );

            const result = await response.json();

            console.log(result);

            if (result.status === 200) {

                showMessage("Student updated successfully", "green");

                getStudents();

            } else {

                showMessage(result.message, "red");

            }

        } catch (error) {

            console.log(error);

            showMessage("Error updating student", "red");

        }

    }


    // ==============================
    // DELETE STUDENT
    // ==============================

    async function deleteStudent() {

        const name = document.getElementById('name').value;

        if (!name) {

            showMessage("Enter student name first", "red");

            return;

        }

        deleteStudentByName(name);

    }


    async function deleteStudentByName(name) {

        const confirmDelete = confirm(
            `Are you sure you want to delete ${name}?`
        );

        if (!confirmDelete) {

            return;

        }

        try {

            const response = await fetch(
                `/student/deletedata?name=${encodeURIComponent(name)}`,
                {

                    method: 'DELETE'

                }
            );

            const result = await response.json();

            console.log(result);

            if (result.status === 200) {

                showMessage("Student deleted successfully", "green");

                document.getElementById('studentForm').reset();

                getStudents();

            } else {

                showMessage(result.message, "red");

            }

        } catch (error) {

            console.log(error);

            showMessage("Error deleting student", "red");

        }

    }


    // ==============================
    // FILL FORM FOR EDIT
    // ==============================

    function fillForm(name, email, age, city) {

        document.getElementById('name').value = name;

        document.getElementById('email').value = email;

        document.getElementById('age').value = age;

        document.getElementById('city').value = city;

        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });

    }


    // ==============================
    // SHOW MESSAGE
    // ==============================

    function showMessage(message, color) {

        const messageBox = document.getElementById('message');

        messageBox.innerText = message;

        messageBox.style.color = color;

        setTimeout(() => {

            messageBox.innerText = '';

        }, 3000);

    }


    // ==============================
    // LOAD DATA WHEN PAGE OPENS
    // ==============================

    getStudents();

</script>

</body>
</html>