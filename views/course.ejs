<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Course Management</title>


    <style>

        body {

            font-family: Arial, sans-serif;

            margin: 30px;

            background-color: #f5f5f5;

        }


        .container {

            background-color: white;

            padding: 25px;

            border-radius: 10px;

            max-width: 1200px;

            margin: auto;

        }


        h1 {

            color: #222;

        }


        form {

            display: grid;

            grid-template-columns: repeat(6, 1fr);

            gap: 10px;

            margin-bottom: 20px;

        }


        input,
        select {

            padding: 10px;

            border: 1px solid #aaa;

            border-radius: 5px;

        }


        button {

            padding: 10px 15px;

            border: none;

            border-radius: 5px;

            cursor: pointer;

            color: white;

        }


        button:hover {

            opacity: 0.8;

        }


        .add-btn {

            background-color: green;

        }


        .update-btn {

            background-color: orange;

        }


        .delete-btn {

            background-color: red;

        }


        .get-btn {

            background-color: blue;

            margin-bottom: 15px;

        }


        table {

            width: 100%;

            border-collapse: collapse;

            background-color: white;

        }


        th,
        td {

            border: 1px solid #aaa;

            padding: 10px;

            text-align: left;

        }


        th {

            background-color: #333;

            color: white;

        }


        tr:nth-child(even) {

            background-color: #f2f2f2;

        }


        .actions button {

            margin-right: 5px;

        }


        #message {

            margin: 15px 0;

            font-weight: bold;

        }


        @media (max-width: 1000px) {

            form {

                grid-template-columns: 1fr;

            }

        }

    </style>

</head>


<body>


<div class="container">

    <h1>Course Management</h1>


    <!-- Course Form -->

    <form id="courseForm">


        <input
            type="text"
            id="courseName"
            placeholder="Course Name"
            required
        >


        <input
            type="text"
            id="courseCode"
            placeholder="Course Code"
            required
        >


        <input
            type="text"
            id="duration"
            placeholder="Duration"
            required
        >


        <input
            type="number"
            id="fees"
            placeholder="Fees"
            required
        >


        <input
            type="text"
            id="category"
            placeholder="Category"
            required
        >


        <input
            type="text"
            id="mode"
            placeholder="Online / Offline"
            required
        >


        <button
            type="submit"
            class="add-btn"
        >
            Add Course
        </button>


        <button
            type="button"
            class="update-btn"
            onclick="updateCourse()"
        >
            Update Course
        </button>


        <button
            type="button"
            class="delete-btn"
            onclick="deleteCourse()"
        >
            Delete Course
        </button>


    </form>


    <div id="message"></div>


    <!-- Get Courses -->

    <button
        class="get-btn"
        onclick="getCourses()"
    >
        Get Courses
    </button>


    <!-- Course Table -->

    <table>

        <thead>

            <tr>

                <th>Course Name</th>

                <th>Course Code</th>

                <th>Duration</th>

                <th>Fees</th>

                <th>Category</th>

                <th>Mode</th>

                <th>Action</th>

            </tr>

        </thead>


        <tbody id="courseTable"></tbody>

    </table>


</div>


<script>


    // ==============================
    // GET COURSES
    // ==============================

    async function getCourses() {

        try {

            const response =
                await fetch('/course/getdata');


            const result =
                await response.json();


            console.log(result);


            const table =
                document.getElementById(
                    'courseTable'
                );


            table.innerHTML = '';


            result.data.forEach(course => {

                const row =
                    document.createElement('tr');


                row.innerHTML = `

                    <td>
                        ${course.courseName || ''}
                    </td>

                    <td>
                        ${course.courseCode || ''}
                    </td>

                    <td>
                        ${course.duration || ''}
                    </td>

                    <td>
                        ${course.fees || ''}
                    </td>

                    <td>
                        ${course.category || ''}
                    </td>

                    <td>
                        ${course.mode || ''}
                    </td>

                    <td class="actions">

                        <button
                            class="update-btn"
                            onclick="fillForm(
                                '${course.courseName || ''}',
                                '${course.courseCode || ''}',
                                '${course.duration || ''}',
                                '${course.fees || ''}',
                                '${course.category || ''}',
                                '${course.mode || ''}'
                            )"
                        >
                            Edit
                        </button>


                        <button
                            class="delete-btn"
                            onclick="deleteCourseByCode(
                                '${course.courseCode}'
                            )"
                        >
                            Delete
                        </button>

                    </td>

                `;


                table.appendChild(row);

            });


            showMessage(
                "Courses loaded successfully",
                "green"
            );


        } catch (error) {

            console.log(error);


            showMessage(
                "Error loading courses",
                "red"
            );

        }

    }


    // ==============================
    // POST / INSERT COURSE
    // ==============================

    document
        .getElementById('courseForm')
        .addEventListener(
            'submit',
            async function(event) {

                event.preventDefault();


                const courseData = {

                    courseName:
                        document.getElementById(
                            'courseName'
                        ).value,


                    courseCode:
                        document.getElementById(
                            'courseCode'
                        ).value,


                    duration:
                        document.getElementById(
                            'duration'
                        ).value,


                    fees:
                        Number(
                            document.getElementById(
                                'fees'
                            ).value
                        ),


                    category:
                        document.getElementById(
                            'category'
                        ).value,


                    mode:
                        document.getElementById(
                            'mode'
                        ).value

                };


                try {

                    const response =
                        await fetch(
                            '/course/insertdata',
                            {

                                method: 'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify(
                                        courseData
                                    )

                            }
                        );


                    const result =
                        await response.json();


                    console.log(result);


                    if (result.status === 200) {

                        showMessage(
                            "Course added successfully",
                            "green"
                        );


                        document
                            .getElementById(
                                'courseForm'
                            )
                            .reset();


                        getCourses();


                    } else {

                        showMessage(
                            result.message,
                            "red"
                        );

                    }


                } catch (error) {

                    console.log(error);


                    showMessage(
                        "Error adding course",
                        "red"
                    );

                }

            }
        );


    // ==============================
    // PUT / UPDATE COURSE
    // ==============================

    async function updateCourse() {


        const courseCode =
            document.getElementById(
                'courseCode'
            ).value;


        if (!courseCode) {

            showMessage(
                "Enter course code first",
                "red"
            );

            return;

        }


        const courseData = {

            courseName:
                document.getElementById(
                    'courseName'
                ).value,


            duration:
                document.getElementById(
                    'duration'
                ).value,


            fees:
                Number(
                    document.getElementById(
                        'fees'
                    ).value
                ),


            category:
                document.getElementById(
                    'category'
                ).value,


            mode:
                document.getElementById(
                    'mode'
                ).value

        };


        try {

            const response =
                await fetch(
                    `/course/updatedata?courseCode=${encodeURIComponent(courseCode)}`,
                    {

                        method: 'PUT',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(
                                courseData
                            )

                    }
                );


            const result =
                await response.json();


            console.log(result);


            if (result.status === 200) {

                showMessage(
                    "Course updated successfully",
                    "green"
                );


                getCourses();


            } else {

                showMessage(
                    result.message,
                    "red"
                );

            }


        } catch (error) {

            console.log(error);


            showMessage(
                "Error updating course",
                "red"
            );

        }

    }


    // ==============================
    // DELETE COURSE
    // ==============================

    async function deleteCourse() {


        const courseCode =
            document.getElementById(
                'courseCode'
            ).value;


        if (!courseCode) {

            showMessage(
                "Enter course code first",
                "red"
            );

            return;

        }


        deleteCourseByCode(courseCode);

    }


    async function deleteCourseByCode(
        courseCode
    ) {


        const confirmDelete =
            confirm(
                `Are you sure you want to delete course ${courseCode}?`
            );


        if (!confirmDelete) {

            return;

        }


        try {

            const response =
                await fetch(
                    `/course/deletedata?courseCode=${encodeURIComponent(courseCode)}`,
                    {

                        method: 'DELETE'

                    }
                );


            const result =
                await response.json();


            console.log(result);


            if (result.status === 200) {

                showMessage(
                    "Course deleted successfully",
                    "green"
                );


                document
                    .getElementById(
                        'courseForm'
                    )
                    .reset();


                getCourses();


            } else {

                showMessage(
                    result.message,
                    "red"
                );

            }


        } catch (error) {

            console.log(error);


            showMessage(
                "Error deleting course",
                "red"
            );

        }

    }


    // ==============================
    // FILL FORM FOR EDIT
    // ==============================

    function fillForm(
        courseName,
        courseCode,
        duration,
        fees,
        category,
        mode
    ) {


        document.getElementById(
            'courseName'
        ).value = courseName;


        document.getElementById(
            'courseCode'
        ).value = courseCode;


        document.getElementById(
            'duration'
        ).value = duration;


        document.getElementById(
            'fees'
        ).value = fees;


        document.getElementById(
            'category'
        ).value = category;


        document.getElementById(
            'mode'
        ).value = mode;


        window.scrollTo({

            top: 0,

            behavior: 'smooth'

        });

    }


    // ==============================
    // MESSAGE
    // ==============================

    function showMessage(
        message,
        color
    ) {


        const messageBox =
            document.getElementById(
                'message'
            );


        messageBox.innerText =
            message;


        messageBox.style.color =
            color;


        setTimeout(() => {

            messageBox.innerText = '';

        }, 3000);

    }


    // ==============================
    // LOAD DATA WHEN PAGE OPENS
    // ==============================

    getCourses();

</script>


</body>

</html>